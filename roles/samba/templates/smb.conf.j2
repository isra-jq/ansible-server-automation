# ==============================================================================
# Managed by Ansible - Samba Server Configuration (smb.conf)
# Target OS: OpenSUSE 16.0
# Task 3 Requirement: Share samba resources including create mask
# ==============================================================================

[global]
    workgroup = {{ samba_workgroup }}
    server string = OpenSUSE 16.0 Automated Samba Server
    netbios name = OPENSUSE-SRV
    security = user
    map to guest = Bad User
    dns proxy = no
    log file = /var/log/samba/log.%m
    max log size = 1000
    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes

# ------------------------------------------------------------------------------
# Shared Resource Definition
# ------------------------------------------------------------------------------
[{{ samba_share_name }}]
    comment = {{ samba_share_comment }}
    path = {{ samba_share_path }}
    valid users = {{ samba_system_user }}
    read only = {{ samba_read_only }}
    browsable = yes
    writable = yes
    guest ok = {{ samba_guest_ok }}
    create mask = {{ samba_create_mask }}
    directory mask = {{ samba_directory_mask }}
    force create mode = {{ samba_create_mask }}
    force directory mode = {{ samba_directory_mask }}
    force user = {{ samba_system_user }}
    force group = {{ samba_system_group }}
